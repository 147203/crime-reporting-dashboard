# Copy to .env and set your own values. Never commit .env.
# Local presentation setup (D-25): XAMPP MariaDB, root with a blank password, for the app and the test schema.
# With APP_ENV=production the app refuses to start unless each DB user has its own password of at least 16 characters.

APP_NAME="Crime Reporting Dashboard"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
# Generate with: php artisan key:generate
APP_KEY=

# Application database: XAMPP MariaDB on 127.0.0.1:3306 (docs/10)
# Local shortcut (D-25): root with a blank password is accepted only when this is true, APP_ENV is local and APP_URL is
# 127.0.0.1 or localhost. Anywhere else the app requires its own user and a 16+ character password.
DB_ALLOW_LOCAL_SHORTCUT=true
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crime_dashboard
DB_USERNAME=root
DB_PASSWORD=

# Test database: separate schema that must end in _test (tests wipe it)
DB_TEST_DATABASE=crime_dashboard_test
DB_TEST_USERNAME=root
DB_TEST_PASSWORD=

# First administrator, created by the seeder. No default exists; at least 14 characters.
# Checked by php artisan app:preflight; may be removed from .env after the first seed (D-23).
ADMIN_NAME="Set Admin Name"
ADMIN_EMAIL=admin@example.invalid
ADMIN_INITIAL_PASSWORD=changeme-set-your-own

# Sessions, cache, queue, logs (no credentials here)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SAME_SITE=strict
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info
BCRYPT_ROUNDS=12
MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"

# Security tuning
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Set to true on any host served over HTTPS
SESSION_SECURE_COOKIE=false
SESSION_EXPIRE_ON_CLOSE=true

# Analytics parameters (calibrated and documented in docs/02)
HOTSPOT_Z_THRESHOLD=1.5
HOTSPOT_MIN_INCIDENTS=10
DUPLICATE_WINDOW_MINUTES=120
DUPLICATE_SIMILARITY=0.8
SAMPLE_DATA_SEED=20260924
